# Environment files: never commit real values. Only *.example files are tracked.
.env
.env.*
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend (see also frontend/.gitignore)
node_modules/
dist/

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# Design handoff packs (root design/ only): kept locally as the visual reference, not tracked (fork only)
/design/
# Logo export pack: the app uses the copies in frontend/public (fork only)
/web-ready-logos/
